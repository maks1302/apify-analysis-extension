{
  "manifest_version": 3,
  "name": "Apify Earnings Dashboard",
  "version": "0.13.0",
  "description": "A local dashboard for visualizing earnings data already loaded by Apify Console.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://console.apify.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://console.apify.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
