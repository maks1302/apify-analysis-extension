{
  "manifest_version": 3,
  "name": "Actor Analytics for Apify",
  "version": "0.26.1",
  "description": "Advanced local analytics for Apify Actors: revenue, profit, runs, users, quality, and acquisition in one dashboard.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://console.apify.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://console.apify.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["logo.svg"],
      "matches": ["https://console.apify.com/*"]
    }
  ]
}
